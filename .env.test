# Fast-path env for the mock suite. Loaded via --env-file so the values reach
# import-time reads (config.ts) — setting them in test module bodies is too
# late under ESM import hoisting (the config import evaluates first), which
# silently left the suite at RETRY_BASE_DELAY_MS=1000 (~285s).
RETRY_BASE_DELAY_MS=50
RETRY_MAX_DELAY_MS=200
# chat_in_progress retry window: fast so the same-chat settle retries (2x) do
# not slow the suite (~50ms + ~100ms instead of 2s + 8s).
CHAT_IN_PROGRESS_RETRY_DELAY_MS=50
CHAT_IN_PROGRESS_BUSY_MS=100
# Mock streams do not need the 4s client-disconnect grace; skipping it saves
# ~4s per disconnect-path test.
STREAM_DISCONNECT_GRACE_MS=0
# Unit test concurrency assumptions test with maxStreamsPerAccount=1
ACCOUNT_MAX_CONCURRENT_STREAMS=1
# Tests bind loopback only (never a public interface) and run with no API key
# so auth-gated routes stay open, exactly like localhost dev without a key.
HOST=127.0.0.1
API_KEY=
# ISOLATION: blank the real-account env so dotenv's load of the developer's
# .env cannot leak production credentials into the test database via
# syncEnvAccounts (which upserts QWEN_ACCOUNTS into whatever DB is active).
# --env-file sets this before any module loads, and dotenv never overrides an
# already-set variable, so the test DB stays hermetic.
QWEN_ACCOUNTS=
# ISOLATION: pin the browser/pool sizing to the schema defaults so the
# developer's .env (config.ts runs `import "dotenv/config"`, which reads the
# local .env) cannot change assertions like config-current's
# maxActiveContexts === 25, nor let pool sizing bleed into test behaviour.
PLAYWRIGHT_MAX_ACTIVE_CONTEXTS=25
PLAYWRIGHT_MAX_PARALLEL_INIT=5
POOL_TARGET_READY=6
POOL_RESERVE_READY=2
POOL_WARMUP_CONCURRENCY=4
# ISOLATION: file logging is ON by default and writes into ./logs; the
# lifecycle/runtime suites start the real server, so keep them hermetic.
# The file-logger unit test initializes its own sink in a temp dir.
LOG_FILE_ENABLED=false
# The bounded model-cap wait is a production latency trade; pin it off so no
# test path can block on a NO_CANDIDATES acquire (preserves fail-fast in suites).
POOL_MODEL_CAP_WAIT_MS=0
# ISOLATION: the developer's .env sets UPSTREAM_DEBUG=true and config.ts does
# `import "dotenv/config"`, so without this pin the variable leaks into the
# suites and utils-logger-full's "UPSTREAM_DEBUG is not set in this process"
# assertion fails for an environmental reason unrelated to the code.
UPSTREAM_DEBUG=
