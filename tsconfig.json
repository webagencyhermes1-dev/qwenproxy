{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["ESNext", "DOM"],
    "types": ["node"]
  },
  "include": [
    "src/api/**/*",
    "src/benchmarks/**/*",
    "src/cache/**/*",
    "src/core/**/*",
    "src/domain/**/*",
    "src/routes/**/*",
    "src/services/**/*",
    "src/sync/**/*",
    "src/tests/**/*",
    "src/tools/**/*",
    "src/tui/**/*",
    "src/types/**/*",
    "src/utils/**/*",
    "src/index.ts",
    "src/login.ts",
    "src/tui/index.ts"
  ],
  "exclude": ["node_modules", "dist", "src/tests/stress/**/*", "src/tests/readiness-guard.test.ts", "src/tests/recovery-metrics.test.ts"]
}
